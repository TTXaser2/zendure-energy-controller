digraph G {
  graph [rankdir=TB, labelloc=t, label="ZEC V17.1.3 — run_once() Control Cycle", fontsize=18];
  node [shape=box, style="rounded", fontsize=9];
  edge [fontsize=8];
  start [shape=circle, label=""];
  stop [shape=doublecircle, label=""];
  cfg [shape=diamond, label="control_allowed?"];
  passive [label="Passive config recovery preflight\ntelemetry only; no command"];
  mqtt [shape=diamond, label="MQTT disconnected\nAND safe-state configured?"];
  safe [label="SAFE_STATE\nactive neutralization 0 W"];
  telem [label="Apply local API snapshot\nupdate grid-meter + display metrics"];
  nightdetect [label="Detect night window\nneutralize ended fixed night command"];
  fastprep [label="Prepare Fast mode\noff | shadow | active"];
  manual [shape=diamond, label="MANUAL_MODE != AUTO?"];
  manhandle [label="Fast O=0; Harvest reset\nhandle_manual_mode"];
  night [shape=diamond, label="night active?"];
  nightSoc [shape=diamond, label="SOC fresh?"];
  reserve [shape=diamond, label="night reserve SOC reached?"];
  fixednight [label="NIGHT_DISCHARGE\nfixed output target"];
  pause [label="Pause fixed night discharge\nactive 0 W if needed\nthen continue AUTO"];
  soc [shape=diamond, label="AUTO SOC fresh?"];
  grid [label="Read grid power for control"];
  gridok [shape=diamond, label="grid read valid?"];
  harvest [label="Update Harvest state\nentry / stay / exit / reason"];
  cc [shape=diamond, label="Existing target violates\nCross-Charge?"];
  cccorr [label="Correct/neutralize existing target\nFast O=0"];
  fastguard [shape=diamond, label="Active Fast overlay or\nreturn-to-baseline pending?"];
  importabort [shape=diamond, label="grid import > abort?"];
  release [shape=diamond, label="grid near zero /\ninsufficient export?"];
  charge_release [label="handle_charge()\nrelease O/B safely"];
  db [shape=diamond, label="|grid| <= DEADBAND?"];
  hactive [shape=diamond, label="Harvest active\nand High-SOC enabled?"];
  hold [label="handle_deadband() -> HOLD"];
  imp [shape=diamond, label="grid > 0 import?"];
  discharge [label="handle_discharge()"];
  charge [label="handle_charge()"];

  start -> cfg;
  cfg -> passive [label="no"];
  passive -> stop;
  cfg -> mqtt [label="yes"];
  mqtt -> safe [label="yes"];
  safe -> stop;
  mqtt -> telem [label="no"];
  telem -> nightdetect -> fastprep -> manual;
  manual -> manhandle [label="yes"];
  manhandle -> stop;
  manual -> night [label="no"];
  night -> nightSoc [label="yes"];
  nightSoc -> safe [label="no"];
  nightSoc -> reserve [label="yes"];
  reserve -> fixednight [label="no"];
  fixednight -> stop;
  reserve -> pause [label="yes"];
  pause -> soc;
  night -> soc [label="no"];
  soc -> safe [label="no"];
  soc -> grid [label="yes"];
  grid -> gridok;
  gridok -> stop [label="no / fail-closed"];
  gridok -> harvest [label="yes"];
  harvest -> cc;
  cc -> cccorr [label="yes"];
  cccorr -> stop;
  cc -> fastguard [label="no"];
  fastguard -> importabort [label="yes"];
  importabort -> charge_release [label="yes"];
  charge_release -> stop;
  importabort -> release [label="no"];
  release -> charge_release [label="yes"];
  release -> db [label="no"];
  fastguard -> db [label="no"];
  db -> hactive [label="yes"];
  hactive -> charge [label="yes"];
  hactive -> hold [label="no"];
  charge -> stop;
  hold -> stop;
  db -> imp [label="no"];
  imp -> discharge [label="yes"];
  imp -> charge [label="no = export"];
  discharge -> stop;

  uml_update_note [shape=note, style="filled", fillcolor="#eef5ff", fontcolor="#162e4d", fontsize=9, label="MIN_SOC beendet die erlaubte Entladung; Grid-Export wird im AUTO-Pfad weiter verarbeitet.\nSourceabgleich: V17.1.3; keine Feldwirkungsbehauptung"];

  cp26_care_02 [shape=note, style="filled", fillcolor="#eaf4ec", fontcolor="#193b2d", fontsize=9, label="BATTERY CARE · CP26 (Entwicklungs-As-built)\nCare-Anforderung nur nach Safety-/Messfreigaben durch bestehenden Command-Owner. Abgeschlossener Zyklus markiert Stage-Provenienz; keine Beobachtungsabkürzung.\nKeine physische Wirksamkeits- oder Releasefreigabe"];
}
