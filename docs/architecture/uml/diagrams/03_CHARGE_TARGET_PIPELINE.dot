digraph G {
  graph [rankdir=TB, labelloc=t, label="ZEC V17.1.3 — AUTO Charge Target Pipeline", fontsize=18];
  node [shape=box, style="rounded", fontsize=9];
  edge [fontsize=8];
  start [shape=circle, label=""];
  maxsoc [shape=diamond, label="SOC >= MAX_SOC?"];
  hold [label="Fast O=0\nactive neutralization\nHOLD + MAX_SOC"];
  reverse [shape=diamond, label="discharge target active?"];
  rampdis [label="Fast O=0\nramp down discharge first"];
  baseline [label="Use isolated slow baseline history B_prev\nnever feed B+O back into B"];
  harvest [shape=diamond, label="Harvest active?"];
  href [shape=diamond, label="Independent physical Zendure\nAC reference valid?"];
  high [shape=diamond, label="HIGH_SMA_SOC branch?"];
  absShare [label="HIGH_SMA_SOC / HIGH_SMA_SOC_SMA_NEAR_LIMIT\nT = primary + Zendure + export\ncurrent Harvest time-profile → PrimaryShare → ZendureShare\nCapture = Zendure charge + export\nraw B = max(ZendureShare, Capture)\ntarget_selected_by = STRATEGIC_SHARE | EXPORT_CAPTURE | BOTH_EQUAL\nABSOLUTE_SHARE_OR_EXPORT_CAPTURE"];
  absCap [label="raw B = Zendure charge + export\nABSOLUTE_EXPORT_CAPTURE\n(NEAR_LIMIT/FULL_IDLE/EXPORT_HOLD)"];
  fallback [label="raw B = B_prev + effective_export * gain\nINCREMENTAL_FALLBACK"];
  auto [label="raw B = B_prev + effective_export * gain\nAUTO_GRID_EXPORT"];
  clamp [label="Clamp B to MAX_CHARGE_POWER"];
  smooth [label="Smoothing"];
  ramp [label="MAX_POWER_STEP / ramp"];
  B [label="Baseline B"];
  fmode [shape=diamond, label="Fast mode?"];
  off [label="off: O=0\ncommand=B"];
  shadow [label="shadow: classify + compute O\nfor diagnostics only\ncommand=B"];
  guards [shape=diamond, label="active guards pass?"];
  fstate [shape=diamond, label="Fast primary state"];
  full [label="FULL_IDLE confirmed\ndesired O=export"];
  near [label="NEAR_LIMIT\nreserve=primary_max-primary_power\ndesired O=max(0,export-reserve)"];
  unknown [label="RESERVE_UNKNOWN\nO=0 immediately"];
  ar [label="A400/R100\nattack 400 W/s\nrelease 100 W/s\ncombined=min(limit,B+O)"];
  cc [shape=diamond, label="Cross-Charge active?"];
  ccyes [label="Force O=0\nre-evaluate Cross-Charge against B only"];
  final [label="signed final target"];
  cmd [label="Command lifecycle\nSmartMode + AC mode + limits"];
  effect [label="Readback + effect monitor\npossible Resync / Late-Effect Guard"];
  stop [shape=doublecircle, label=""];

  start -> maxsoc;
  maxsoc -> hold [label="yes"];
  hold -> stop;
  maxsoc -> reverse [label="no"];
  reverse -> rampdis [label="yes"];
  rampdis -> stop;
  reverse -> baseline [label="no"];
  baseline -> harvest;
  harvest -> href [label="yes"];
  href -> high [label="yes"];
  high -> absShare [label="yes"];
  high -> absCap [label="no"];
  href -> fallback [label="no"];
  harvest -> auto [label="no"];
  absShare -> clamp;
  absCap -> clamp;
  fallback -> clamp;
  auto -> clamp;
  clamp -> smooth -> ramp -> B -> fmode;
  fmode -> off [label="off"];
  fmode -> shadow [label="shadow"];
  fmode -> guards [label="active"];
  guards -> unknown [label="no / forced zero"];
  guards -> fstate [label="yes"];
  fstate -> full [label="FULL_IDLE"];
  fstate -> near [label="NEAR_LIMIT"];
  fstate -> unknown [label="RESERVE_UNKNOWN"];
  full -> ar;
  near -> ar;
  unknown -> cc;
  ar -> cc;
  off -> cc;
  shadow -> cc;
  cc -> ccyes [label="yes"];
  ccyes -> final;
  cc -> final [label="no"];
  final -> cmd -> effect -> stop;

  uml_update_note [shape=note, style="filled", fillcolor="#eef5ff", fontcolor="#162e4d", fontsize=9, label="S3: nur opt-in; saisonale strategische Anteile bleiben dem Export-Capture-Floor nachgeordnet.\nSourceabgleich: V17.1.3; keine Feldwirkungsbehauptung"];
}
