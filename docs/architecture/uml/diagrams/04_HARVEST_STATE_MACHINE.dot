digraph Harvest {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.8, labelloc=t,
         label="04 — Harvest / Restüberschuss: Entry–Stay–Exit State Machine", fontsize=20, fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="white", fontname="DejaVu Sans", fontsize=11, margin="0.13,0.08"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#444444"];

  start [shape=circle, width=.18, label="", fillcolor="#222222", style=filled];
  inactive [label="INACTIVE\nHarvest nicht aktiv"];
  confirm [label="ENTRY_CONFIRM\nEligibility bestätigt sich über\nfrische/distinkte Beobachtungen"];
  active [label="ACTIVE\nBaseline-Zweig aktiv\nReason = klassifizierter Branch"];
  hold [label="EXPORT_HOLD\nEligibility kurz verloren\nHold läuft nur mit neuen Beobachtungen"];
  band [label="PRIMARY_BAND_LIMIT / NOT_ELIGIBLE\nkein neuer Harvest-Druck\naber SOC noch oberhalb Exit"];
  reset [shape=note, fillcolor="#f7f7f7", label="Voraussetzungen (Auszug)\nREST_SURPLUS_HARVEST_ENABLED\nPrimär-Max-Ladeleistung bekannt\nCross-Charge enabled\nPrimärdaten fresh + valid\nZendure SOC < MAX_SOC\nMQTT-Safety nicht verletzt"];
  reasons [shape=note, fillcolor="#f7f7f7", label="Reason-Priorität\n1 SMA_FULL_OR_IDLE\n2 HIGH_SMA_SOC_SMA_NEAR_LIMIT\n3 HIGH_SMA_SOC\n4 SMA_NEAR_LIMIT"];
  timing [shape=note, fillcolor="#f7f7f7", label="Zeitsemantik\nmonotonic elapsed time\n+ distinct grid/primary samples\nHost-Stall zählt nicht als viele Samples"];
  orth [shape=note, fillcolor="#f7f7f7", label="Wichtig: Harvest ist KEIN current_mode.\nEs beeinflusst die Baseline-Zielwertbildung\nim AUTO-Ladepfad."];

  start -> inactive;
  inactive -> inactive [label="Prerequisite fehlt / reset(reason)"];
  inactive -> confirm [label="eligible_now"];
  confirm -> confirm [label="neue unabhängige Beobachtung\nentry_progress += elapsed"];
  confirm -> active [label="entry_progress >= confirm"];
  confirm -> inactive [label="Eligibility vor Confirm verloren"];
  active -> active [label="eligible_now / Hold auffrischen"];
  active -> hold [label="!eligible && SOC >= exit && hold > 0"];
  hold -> hold [label="neue Beobachtung / Hold dekrementieren"];
  hold -> active [label="Eligibility kehrt zurück"];
  hold -> band [label="Hold abgelaufen"];
  active -> band [label="!eligible && kein Hold\nSOC >= exit"];
  band -> active [label="eligible_now"];
  active -> inactive [label="SOC < High-SOC-Exit\nHIGH_SMA_SOC_EXIT"];
  hold -> inactive [label="SOC < Exit"];
  band -> inactive [label="SOC < Exit"];

  {rank=same; reset; inactive}
  reset -> inactive [style=dashed, arrowhead=none];
  confirm -> reasons [style=dashed, arrowhead=none];
  confirm -> timing [style=dashed, arrowhead=none];
  active -> orth [style=dashed, arrowhead=none];

  uml_update_note [shape=note, style="filled", fillcolor="#eef5ff", fontcolor="#162e4d", fontsize=9, label="S3-Profilfenster und Bestätigungszeiten kommen aus Runtime-Settings (statt nur Festwerten).\nSourceabgleich: V17.1.3; keine Feldwirkungsbehauptung"];
}
