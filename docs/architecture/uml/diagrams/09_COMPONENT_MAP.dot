digraph Components {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.9, labelloc=t,
         label="09 — ZEC Regler: Komponenten- und Datenfluss-Landkarte", fontsize=20, fontname="DejaVu Sans", compound=true];
  node [shape=box, style="rounded,filled", fillcolor="white", fontname="DejaVu Sans", fontsize=10.5, margin="0.13,0.07"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#444444"];

  subgraph cluster_inputs { label="Inputs / Quellen"; fontname="DejaVu Sans"; color="#aaaaaa";
    grid [label="Grid Meter\nSMA Speedwire oder Shelly HTTP"];
    primary [label="Primary Storage Source\nEVCC / Custom MQTT / Modbus Template"];
    ztel [label="Zendure Telemetry\nMQTT + lokale API-Snapshots"];
    cfg [label="Effective Config\nSettingsRegistry + valid snapshot"];
  }
  subgraph cluster_core { label="Control Core"; fontname="DejaVu Sans"; color="#aaaaaa";
    core [label="ZendureController\ncontroller_logic.py\nState + Branching + Target Pipeline"];
    state [label="ControllerState\nSnapshots • Reasons • Limiter • Diagnostics"];
    cmd [label="Command Lifecycle\nIntent • Desired Batch • Readback Gates\nDedupe • Effect Watch • Resync"];
  }
  subgraph cluster_device { label="Gerätepfad"; fontname="DejaVu Sans"; color="#aaaaaa";
    mqtt [label="MQTT Client"];
    zend [label="Zendure SolarFlow 2400 AC+"];
  }
  subgraph cluster_evidence { label="Evidence / Beobachtung"; fontname="DejaVu Sans"; color="#aaaaaa";
    meas [label="Measurement V4 / SQLite\ncycle-exakte Evidenz"];
    status [label="Status & Diagnostics"];
    graphui [label="Graph Core V3"];
    fasta [label="Fast-Capture Field Analyzer\nread-only"];
    careEvents [label="OperationalEventJournal / SQLite\nBattery-Care-Warnvorfall OPEN\nWrite-through nur bei bestätigtem Mismatch"];
  }

  grid -> core [label="Netzleistung + freshness"];
  primary -> core [label="Power/SOC + validity"];
  cfg -> core [label="Regelparameter"];
  ztel -> state [label="SOC, power, command readback"];
  state -> core [label="frischer State", dir=both];
  core -> cmd [label="signed target + reason"];
  cmd -> mqtt [label="smartMode/acMode/limits"];
  mqtt -> zend;
  zend -> ztel [label="Readback + physische Telemetrie"];
  state -> meas;
  state -> status;
  cmd -> careEvents [style=dashed, label="Notlade-Mismatch: synchroner Commit\nkurzer Timeout, Fehlerstatus + Retry"];
  state -> careEvents [style=dashed, label="asynchrone Recovery: frische SOC-Proben"];
  careEvents -> status [label="persistierte OPEN-Events"];
  meas -> graphui;
  meas -> fasta;

  diag [shape=note, fillcolor="#f7f7f7", label="Diagnostik ≠ Reglerinput:\nprimary_usable_soc_percent bleibt in V17\nfür FULL/IDLE, High-SOC, Fast und Safety ohne Reglerwirkung."];
  rt [shape=note, fillcolor="#f7f7f7", label="Regelzyklus-Prinzip:\nkeine externen Netzwerk-/Geräte-I/O im Regelpfad;\nausnahmsweise bounded SQLite-Commit\nnur bei bestätigter Notlade-Nichtwirkung."];
  state -> diag [style=dashed, arrowhead=none];
  core -> rt [style=dashed, arrowhead=none];

  uml_update_note [shape=note, style="filled", fillcolor="#eef5ff", fontcolor="#162e4d", fontsize=9, label="Live-Status-Poll 1000 ms; Minigraph-Poll 3000 ms; Reglerzyklus unverändert. Quelle/Alter unabhängig.\nSourceabgleich: V17.1.3; keine Feldwirkungsbehauptung"];

  cp26_care_09 [shape=note, style="filled", fillcolor="#eaf4ec", fontcolor="#193b2d", fontsize=9, label="BATTERY CARE · CP26 (Entwicklungs-As-built)\nCare Module: pure Policy, PV-Arbiter, Grid-Beobachtung, persistente Episoden. OperationalEventJournal: mehrere Notladevorfälle und bestätigte Stage-Transition nach 2 abgeschlossenen Zyklen; SOC-Graph read-only.\nKeine physische Wirksamkeits- oder Releasefreigabe"];
}
