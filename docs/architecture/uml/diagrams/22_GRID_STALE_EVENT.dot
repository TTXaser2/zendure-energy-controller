digraph Stale {graph [label="22 — Grid-Stale: Diagnoseereignis ≠ Regelmodus (V17.1.3)",labelloc=t,rankdir=TB,fontname="DejaVu Sans"];node [shape=box,style="rounded,filled",fillcolor="white",fontname="DejaVu Sans"]; snap [label="Controller-Grid-Alter / Quelle / Zeitstempel"]; bad [shape=diamond,label="Daten fehlen / sind zu alt?"]; source [label="Quellalter mit Controlleralter vergleichen\nSMA_SOURCE_STALE / SHELLY_SOURCE_STALE\noder CONTROLLER_PROCESSING_STALE"]; open [label="Stabiler Fehler ≥ 6 s\nOperational Event OPEN einmalig"]; good [label="Stabil gesund ≥ 4 s\nOperational Event RESOLVED"]; none [label="Kein neuer Incident; kein Moduskommando"]; note [label="Unabhängige Safety-/Regelentscheidung\nverändert sich nicht durch Event",shape=note];snap->bad;bad->source [label="ja"];source->open;bad->good [label="nein, nach offenem Incident"];bad->none [label="normal"];open->note [style=dashed];good->note [style=dashed];}
