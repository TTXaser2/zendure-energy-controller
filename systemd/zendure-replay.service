[Unit]
Description=Zendure Energy Controller Replay/CSV Analyse
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/zendure-controller
ExecStart=/usr/bin/python3 /opt/zendure-controller/tools/replay_web.py --host 0.0.0.0 --port 8090
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Der Replay-Dienst ist bewusst von der Live-Regelung getrennt und wird nicht automatisch aktiviert.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/zendure-controller

[Install]
WantedBy=multi-user.target
