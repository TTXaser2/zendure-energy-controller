[Unit]
Description=Zendure Energy Controller Replay/CSV Analyse
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/zendure-controller
ExecStart=/usr/bin/python3 /opt/zendure-controller/tools/replay_web.py --host 0.0.0.0 --port 8090
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# V12.9.1: Ressourcenschutz für Raspberry-Pi-Betrieb.
# Schwere Analysen laufen zusätzlich in einem isolierten Worker mit eigenem
# Timeout/RSS-Limit. Das cgroup-Limit umfasst Webdienst plus Worker und bleibt
# bewusst unterhalb des Gesamtspeichers, damit Live-Regler, MQTT und EVCC nicht
# in Swap-/I/O-Stress geraten.
MemoryAccounting=yes
CPUAccounting=yes
IOAccounting=yes
MemoryHigh=450M
MemoryMax=550M
CPUQuota=50%
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7

# Der Replay-Dienst ist bewusst von der Live-Regelung getrennt.
# Er kann dauerhaft aktiviert oder bei Bedarf manuell gestartet werden.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/zendure-controller

[Install]
WantedBy=multi-user.target
